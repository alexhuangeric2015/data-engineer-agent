        </mxCell>
        <mxCell id="draft" value="&lt;b&gt;草稿&lt;/b&gt;&lt;br&gt;&lt;br&gt;来源已登记&lt;br&gt;模型抽取仍为草稿" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=20;fontColor=#172033;fillColor=#FEF3C7;strokeColor=#B45309;spacing=12;">
          <mxGeometry as="geometry" x="60" y="260" width="300" height="145" />
        </mxCell>
        <mxCell id="pending" value="&lt;b&gt;待确认&lt;/b&gt;&lt;br&gt;&lt;br&gt;技术核验及业务确认&lt;br&gt;缺项或歧义未解除" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=20;fontColor=#172033;fillColor=#FEF3C7;strokeColor=#B45309;spacing=12;">
          <mxGeometry as="geometry" x="425" y="260" width="300" height="145" />
        </mxCell>
        <mxCell id="confirmed" value="&lt;b&gt;已确认&lt;/b&gt;&lt;br&gt;&lt;br&gt;责任人+记录+版本&lt;br&gt;尚未进入运行知识" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=20;fontColor=#172033;fillColor=#FEF3C7;strokeColor=#B45309;spacing=12;">
          <mxGeometry as="geometry" x="790" y="260" width="300" height="145" />
        </mxCell>
        <mxCell id="staged" value="&lt;b&gt;发布准备&lt;/b&gt;&lt;br&gt;&lt;br&gt;结构记录/知识资料&lt;br&gt;均就绪且版本一致" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=20;fontColor=#172033;fillColor=#FEF3C7;strokeColor=#B45309;spacing=12;">
          <mxGeometry as="geometry" x="1155" y="260" width="300" height="145" />
        </mxCell>
