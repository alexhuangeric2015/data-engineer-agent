        </mxCell>
        <mxCell id="footer" value="迁移约束：只有可信确认记录可推进已确认；技术核验成功不等于业务口径已认可。正式发布必须校验来源、权限、版本及知识更新结果。" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=18;fontColor=#172033;fillColor=#F3F4F6;strokeColor=#94A3B8;spacing=12;">
          <mxGeometry as="geometry" x="40" y="940" width="1840" height="80" />
        </mxCell>
      </root>
