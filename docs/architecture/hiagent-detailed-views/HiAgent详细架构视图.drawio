        </mxCell>
        <mxCell id="subtitle" value="状态视图｜状态属于一个定义版本；确认人、确认记录、发布批次和有效期均需绑定，Excel状态不是可信授权。" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=18;fontColor=#172033;fillColor=#F3F4F6;strokeColor=#94A3B8;spacing=12;fillColor=none;strokeColor=none;align=left;spacing=0;fontStyle=0;">
