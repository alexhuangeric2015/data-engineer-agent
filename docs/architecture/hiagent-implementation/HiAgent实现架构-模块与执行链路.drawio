  <diagram id="01" name="01-模块与部署边界">
    <mxGraphModel dx="1920" dy="1510" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1920" pageHeight="1510" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="01  基于 HiAgent 的实现架构 · 模块、子模块与部署边界" parent="1" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#94A3B8;fontColor=#172033;fontFamily=PingFang SC;fontSize=30;spacing=12;fillColor=none;strokeColor=none;align=left;fontColor=#334155;fontStyle=1;spacing=0;">
          <mxGeometry as="geometry" x="40" y="20" width="1840" height="50" />
        </mxCell>
        <mxCell id="sub" value="目标设计｜HiAgent 内配置 + 项目后端模块 + 既有平台适配；逻辑模块不等于微服务。原总体图保持不变。" parent="1" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#94A3B8;fontColor=#172033;fontFamily=PingFang SC;fontSize=19;spacing=12;fillColor=none;strokeColor=none;align=left;fontColor=#334155;fontStyle=0;spacing=0;">
          <mxGeometry as="geometry" x="40" y="80" width="1840" height="35" />
        </mxCell>
        <mxCell id="hiagent" value="A. HiAgent 内：我们配置和维护" parent="1" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#172033;fontFamily=PingFang SC;fontSize=19;spacing=12;swimlane;startSize=42;container=1;pointerEvents=0;horizontal=1;align=left;fontStyle=1;spacingLeft=14;">
          <mxGeometry as="geometry" x="40" y="150" width="470" height="1150" />
        </mxCell>
        <mxCell id="h1" value="&lt;b&gt;H1 数据研发助手应用&lt;/b&gt;&lt;br&gt;&lt;br&gt;一个入口 / 场景路由 / 模型绑定&lt;br&gt;主提示词 / 会话内澄清与用户选择&lt;br&gt;先复用现有对话界面，不先建新工作台" parent="hiagent" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#172033;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry as="geometry" x="20" y="70" width="430" height="225" />
        </mxCell>
        <mxCell id="h2" value="&lt;b&gt;H2 场景 SKILL 包&lt;/b&gt;&lt;br&gt;&lt;br&gt;资产查询 / 需求解析 / 分层建模&lt;br&gt;代码生成与评审 / 质量 / 运维&lt;br&gt;每包：前置条件、步骤、工具合同、产出" parent="hiagent" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#172033;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry as="geometry" x="20" y="335" width="430" height="225" />
        </mxCell>
        <mxCell id="h3" value="&lt;b&gt;H3 知识库与模型配置&lt;/b&gt;&lt;br&gt;&lt;br&gt;业务术语 / 口径 / 分层与编码规范&lt;br&gt;历史方案 / 评审规则 / 故障手册&lt;br&gt;模型、知识检索与检索模型优先平台托管" parent="hiagent" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#172033;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry as="geometry" x="20" y="600" width="430" height="225" />
        </mxCell>
        <mxCell id="h4" value="&lt;b&gt;H4 场景工作流&lt;/b&gt;&lt;br&gt;&lt;br&gt;需求抽取 → 查事实 → 澄清 → 生成&lt;br&gt;调用工具校验 → 返回结果 → 用户确认&lt;br&gt;节点与跨轮传递按实际平台能力搭建" parent="hiagent" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#172033;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry as="geometry" x="20" y="865" width="430" height="225" />
        </mxCell>
        <mxCell id="backend" value="B. 项目业务后端：规划开发；首版可一个进程部署" parent="1" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#172033;fontFamily=PingFang SC;fontSize=19;spacing=12;swimlane;startSize=42;container=1;pointerEvents=0;horizontal=1;align=left;fontStyle=1;spacingLeft=14;">
          <mxGeometry as="geometry" x="650" y="150" width="770" height="1150" />
        </mxCell>
        <mxCell id="b1" value="&lt;b&gt;B1 资产与业务语义&lt;/b&gt;&lt;br&gt;&lt;br&gt;元数据读取 / 采集快照与差异 / 字段字典映射&lt;br&gt;术语与指标查询 / 血缘查询 / 待确认补全&lt;br&gt;产出：已核验资产、来源版本、缺口与冲突" parent="backend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#172033;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry as="geometry" x="20" y="65" width="730" height="180" />
        </mxCell>
        <mxCell id="b2" value="&lt;b&gt;B2 研发校验与交付适配&lt;/b&gt;&lt;br&gt;&lt;br&gt;需求与模型合同检查 / SQL方言与AST校验&lt;br&gt;命名和分层规则 / EXPLAIN / 隔离试跑与对账&lt;br&gt;产出：带证据的校验结果、代码差异与交付引用" parent="backend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#172033;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry as="geometry" x="20" y="275" width="730" height="180" />
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;B3 数据质量执行&lt;/b&gt;&lt;br&gt;&lt;br&gt;规则登记与适用范围 / 六类规则执行适配&lt;br&gt;基线与异常结果 / 影响分析 / 修复与复验&lt;br&gt;产出：检查运行ID、问题明细、修复验证结果" parent="backend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#172033;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry as="geometry" x="20" y="485" width="730" height="180" />
        </mxCell>
        <mxCell id="b4" value="&lt;b&gt;B4 调度与运行处置&lt;/b&gt;&lt;br&gt;&lt;br&gt;作业读取 / 依赖DAG校验 / 配置与发布适配&lt;br&gt;实例与日志查询 / 诊断证据 / 受控重试与补数&lt;br&gt;产出：作业或实例ID、状态、处置结果" parent="backend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#172033;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry as="geometry" x="20" y="695" width="730" height="180" />
        </mxCell>
        <mxCell id="b5" value="&lt;b&gt;B5 任务与成果记录&lt;/b&gt;&lt;br&gt;&lt;br&gt;任务基准与确认版本 / 设计SQL及报告版本&lt;br&gt;证据引用 / 校验状态 / 执行授权与失效检查&lt;br&gt;产出：可续接的任务快照、成果ID及验证状态" parent="backend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#172033;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry as="geometry" x="20" y="905" width="730" height="180" />
        </mxCell>
        <mxCell id="external" value="C. 原系统：复用，存在与接口待核实" parent="1" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#172033;fontFamily=PingFang SC;fontSize=19;spacing=12;swimlane;startSize=42;container=1;pointerEvents=0;horizontal=1;align=left;fontStyle=1;spacingLeft=14;">
          <mxGeometry as="geometry" x="1540" y="150" width="340" height="1150" />
        </mxCell>
        <mxCell id="c1" value="表结构/字典库【已有】&lt;br&gt;资产目录、指标与血缘平台&lt;br&gt;原系统负责人维护权威事实" parent="external" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#172033;fontFamily=PingFang SC;fontSize=19;spacing=12;">
