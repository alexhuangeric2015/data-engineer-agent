        <mxCell id="s11" value="资产查询 SKILL&lt;br&gt;H3知识库定位候选&lt;br&gt;再调用事实核验工具" parent="1" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#172033;fontFamily=PingFang SC;fontSize=19;spacing=12;">
