        <mxCell id="c2" value="代码仓库 / 开发环境&lt;br&gt;SQL引擎 / 测试数据&lt;br&gt;既有评审与发布流程" parent="external" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#172033;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry as="geometry" x="20" y="275" width="300" height="180" />
        </mxCell>
        <mxCell id="c3" value="质量平台 / 计算引擎&lt;br&gt;业务数据 / 对照数据&lt;br&gt;历史质量结果" parent="external" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#172033;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry as="geometry" x="20" y="485" width="300" height="180" />
        </mxCell>
        <mxCell id="c4" value="调度平台 / 数据接入平台&lt;br&gt;日志监控 / 告警与工单&lt;br&gt;原平台执行并记录实例" parent="external" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#172033;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry as="geometry" x="20" y="695" width="300" height="180" />
        </mxCell>
        <mxCell id="c5" value="既有任务或交付记录【优先】&lt;br&gt;代码/文档版本与文件存储&lt;br&gt;不足时补项目成果存储" parent="external" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#172033;fontFamily=PingFang SC;fontSize=19;spacing=12;">
